[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/ChoiceCard.gd" id="1_script"]

[node name="ChoiceCard" type="Control"]
custom_minimum_size = Vector2(200, 300)
layout_mode = 3
anchors_preset = 0
script = ExtResource("1_script")

[node name="Panel" type="Panel" parent="."]
modulate = Color(1, 0.82, 0.86, 1)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Icon" type="TextureRect" parent="Panel/VBoxContainer"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
stretch_mode = 5

[node name="Title" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.2, 0.5, 1)
theme_override_font_sizes/font_size = 18
text = "Robe Name"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Description" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.2, 0.4, 1)
theme_override_font_sizes/font_size = 14
text = "Increases something by something."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Border" type="ReferenceRect" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
border_color = Color(1, 1, 1, 1)
border_width = 3.0
editor_only = false

[connection signal="gui_input" from="." method="_on_gui_input"]
[connection signal="mouse_entered" from="." method="_on_mouse_entered"]
[connection signal="mouse_exited" from="." method="_on_mouse_exited"]
